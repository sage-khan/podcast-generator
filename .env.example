# --- LLM provider (used by podcast script generation) ---------------------
# Supported values: openrouter (default, matches this project's prior
# behavior), openai, anthropic, gemini, groq, grok, ollama, vllm.
# Meta/Llama models aren't a separate provider entry — reach them by setting
# LLM_PROVIDER=groq|openrouter|ollama|vllm and LLM_MODEL to a llama model id.
LLM_PROVIDER=openrouter
# Optional: override the provider's default model.
LLM_MODEL=openai/gpt-4o
OPENROUTER_API_KEY="openrouter_api_key"
OPENAI_API_KEY="openai_api_key"
ANTHROPIC_API_KEY="anthropic_api_key"
GEMINI_API_KEY="gemini_api_key"
GROQ_API_KEY="groq_api_key"
XAI_API_KEY="xai_grok_api_key"
# Local inference — no API key needed, just a running server.
OLLAMA_BASE_URL="http://localhost:11434/v1"
VLLM_BASE_URL="http://localhost:8000/v1"

# Replicate API credentials
REPLICATE_API_TOKEN="replicate_api_token"
REPLICATE_OWNER="replicate_owner"
REPLICATE_LORA_TRAINER_MODEL="replicate_lora_trainer_model"

# Replicate API credentials (Original - if still needed elsewhere)
REPLICATE_API_TOKEN_SAGE="replicate_api_token_sage"
REPLICATE_OWNER_SAGE="replicate_owner_sage" # Default owner for general use

# Hugging Face token
HF_TOKEN="hugging_face_token"

# Django configuration
DJANGO_SECRET_KEY="django_secret_key"
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Hosts that must always be allowed in addition to DJANGO_ALLOWED_HOSTS (comma-separated, optional)
CRITICAL_HOSTS=
DJANGO_SETTINGS_MODULE=config.settings
DJANGO_SUPERUSER_USERNAME="admin"
DJANGO_SUPERUSER_PASSWORD="admin1234"
DJANGO_SUPERUSER_EMAIL="admin@admin.com"
DJANGO_ENVIRONMENT=development

# Swagger/OpenAPI contact info (shown at /api/docs/)
API_CONTACT_EMAIL="api-support@example.com"
API_TERMS_URL="https://example.com/terms/"

# GitHub credentials
GITHUB_PAT_CLASSIC="github_pat_classic"
GITHUB_PAT="github_pat"
GITHUB_REPO="github_repo"
GITHUB_BRANCH="main"

## Database settings (used by Docker Compose)
POSTGRES_DB="postgres_db"
POSTGRES_USER="postgres_user"
POSTGRES_PASSWORD="postgres_password"
DATABASE_URL="postgresql://postgres_user:postgres_password@db:5432/postgres_db"
DB_ENGINE="django.db.backends.postgresql" # Ensure Django uses the right engine
DB_HOST=db
DB_PORT=5432
DB_SSLMODE="disable"
DB_SSLROOTCERT="/etc/ssl/certs/postgres-ca.crt"
POSTGRES_FORCE_SSL=False
POSTGRES_DISABLE_SSL=True
# Storage configuration
# One of: local (default), do_spaces, s3 (AWS), gcs (Google Cloud Storage),
# r2 (Cloudflare R2), azure_blob. do_spaces/s3/gcs/r2 all share one
# S3-compatible client; azure_blob uses the separate azure-storage-blob SDK.
STORAGE_BACKEND=do_spaces

DROPLET_SSH_KEY="droplet_ssh_key"

# Local storage paths (relative to project root)
LOCAL_STORAGE_BASE_PATH="./media"

# Digital Ocean Spaces configuration (STORAGE_BACKEND=do_spaces)
DO_API_TOKEN="do_api_token"
DO_SPACES_BUCKET="do_spaces_bucket"
DO_SPACES_REGION="do_spaces_region"
DO_SPACES_ENDPOINT="do_spaces_endpoint"
DO_SPACES_ORIGIN_ENDPOINT="do_spaces_origin_endpoint"
DO_SPACES_CDN_ENDPOINT="do_spaces_cdn_endpoint"
DO_SPACES_KEY="do_spaces_key"
DO_SPACES_SECRET="do_spaces_secret"
DO_SPACES_BASE_URL="do_spaces_base_url"
DO_DROPLET_IP="do_droplet_ip"
DOMAIN="domain"
DO_SPACES_KEY_NAME="spaces-access-key"

# AWS S3 configuration (STORAGE_BACKEND=s3)
AWS_S3_BUCKET="aws_s3_bucket"
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID="aws_access_key_id"
AWS_SECRET_ACCESS_KEY="aws_secret_access_key"

# Google Cloud Storage configuration (STORAGE_BACKEND=gcs)
# GCS_HMAC_* are HMAC keys for GCS's S3-interoperability API, generated via
# `gcloud storage hmac create`, not your regular GCP service-account key.
GCS_BUCKET="gcs_bucket"
GCS_HMAC_ACCESS_KEY="gcs_hmac_access_key"
GCS_HMAC_SECRET="gcs_hmac_secret"

# Cloudflare R2 configuration (STORAGE_BACKEND=r2)
R2_BUCKET="r2_bucket"
R2_ENDPOINT="https://<account_id>.r2.cloudflarestorage.com"
R2_ACCESS_KEY_ID="r2_access_key_id"
R2_SECRET_ACCESS_KEY="r2_secret_access_key"

# Azure Blob Storage configuration (STORAGE_BACKEND=azure_blob)
# Requires `pip install azure-storage-blob`. Either set the connection
# string, or set the account URL + key pair — not both.
AZURE_STORAGE_CONTAINER="azure_container"
AZURE_STORAGE_CONNECTION_STRING="azure_storage_connection_string"
AZURE_STORAGE_ACCOUNT_URL="https://<account>.blob.core.windows.net"
AZURE_STORAGE_ACCOUNT_KEY="azure_storage_account_key"



DO_ALL_BUCKETS="do_all_buckets_name"
DO_ALL_BUCKETS_KEY="do_all_buckets_key"
DO_ALL_BUCKETS_SECRET="do_all_buckets_secret"

# Storage paths for different API endpoints
CHARACTER_GENERATION_PATH="character_generation/output"
POSE_GENERATION_PATH="pose_generation/output"
MODEL_TRAINING_PATH="model_training/output"
MODEL_GENERATION_PATH="model_generation/output"

# Webhook configuration
WEBHOOK_BASE_URL="webhook_base_url"
K8S_WEBHOOK_BASE_URL="webhook_base_url"

#K8S Digital Ocean Setup
K8S_DOMAIN="k8s_domain"
K8S_DOMAIN_IP="k8s_domain_ip"
K8S_NAMESPACE="k8s_namespace"
K8S_REGISTRY="k8s_registry"
K8S_REGISTRY_NAME="k8s_registry_name"
K8S_IMAGE_NAME="k8s_image_name"
K8S_DEPLOYMENT_NAME="k8s_deployment_name"
AWS_ACCESS_KEY="aws_access_key"
AWS_SECRET_KEY="aws_secret_key"
K8S_CERTIFICATE_AUTHORITY_DATA="k8s_certificate_authority_data"